#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 128) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint data[];
};

layout(push_constant, std430) uniform Args {
    Words src;
    Words dst;
    uint count;
} args;

void main() {
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < args.count; i += stride)
        args.dst.data[i] = ~args.src.data[i];
}
